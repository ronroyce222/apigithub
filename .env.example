# Application Configuration
# Copy this file to .env and fill in the values

# Server settings
HOST=0.0.0.0
PORT=8080
DEBUG=false
LOG_LEVEL=INFO

# AWS Configuration
AWS_REGION=us-east-1

# SNS Topic ARNs (required) - LocalStack topics
GITHUB_SNS_TOPIC_ARN=arn:aws:sns:us-east-1:000000000000:github-events

# SQS Queue URLs (optional) - LocalStack queues
GITHUB_SQS_QUEUE_URL=http://localhost:4566/000000000000/github-events-queue

# Webhook Secrets (required)
GITHUB_WEBHOOK_SECRET=github-secret

# LocalStack Configuration (for testing)
USE_LOCALSTACK=true
LOCALSTACK_ENDPOINT=http://localhost:4566

# GitHub API Configuration
GITHUB_BASE_URL=https://api.github.com
GITHUB_TOKEN=your-github-personal-access-token
GITHUB_API_TIMEOUT=30.0

# Claude Code Configuration
CLAUDE_CODE_PATH=/path/to/claude-code
CLAUDE_CODE_MODEL=claude-sonnet-4-20250514
CLAUDE_CODE_TIMEOUT=300.0
CODE_REVIEW_ENABLED=true
